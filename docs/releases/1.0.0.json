      "changes": [
        {
          "migrationId": "20261024141558_InitialOobManagement",
          "summary": "建立服务器、用户、偏好、库存、指标、采样、轮次、电源意图八张基础表；采样使用含时间列的复合主键并建立 TimescaleDB 超表。"
        },
        {
          "migrationId": "20261024142053_ExplicitApplicationIds",
          "summary": "普通主键取消数据库 Identity，统一由项目 IIdService 发号；保留已有主键及关联。"
        },
        {
          "migrationId": "20261024163113_PerServerCertificatePolicy",
          "summary": "增加服务器 IgnoreCertificateErrors，默认 true；显式指纹优先，允许按设备控制证书验证。"
        },
        {
          "migrationId": "20261024171205_SystemExceptionLogs",
          "summary": "增加 OOB_SYSTEM_EXCEPTION 脱敏异常记录表及检索索引。"
        },
        {
          "migrationId": "20261026005000_UnifiedFanPercentage",
          "summary": "归并历史 PWM/百分比指标、样本和 JSON，仅保留每物理风扇一条百分比系列；会删除归并记录，Down 不支持，恢复依赖迁移前配套备份。"
        },
        {
          "migrationId": "20261101055105_UserManagementPermissions",
          "summary": "增加用户资料、软删除、规范化账号、独立权限及安全/并发版本；拒绝空白或重复规范化账号，回填既有管理员权限。"
        },
        {
          "migrationId": "20261101062142_ServerAndPowerPermissions",
          "summary": "增加服务器管理与电源操作权限，按既有管理员身份回填并递增安全/并发版本；新账号权限默认 false。"
        },
        {
          "migrationId": "20261102061710_AddMailSending",
          "summary": "增加单 SMTP 配置 OOB_MAIL_CONFIGURATION 和本系统发件意图/结果 OOB_MAIL_MESSAGE 两张表。"
        },
        {
          "migrationId": "20261102103725_AddOperationMailReports",
          "summary": "邮件表增加 HtmlBody、配置表增加 ReportSchedulesJson，支持运行报表快照和日周月计划。"
        },
        {
          "migrationId": "20261102130630_AddMcpManagement",
          "summary": "增加七张 MCP 服务配置、调用方、工具/设备/网络白名单、调用日志及配置审计表；外部 MCP 默认关闭。"
        }
      ]
    },
