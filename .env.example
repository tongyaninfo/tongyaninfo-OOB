# 通研带外系统管理 - 环境变量示例
#
# 复制为 .env 或直接导出环境变量后使用；.env 已被 .gitignore 忽略，禁止提交真实值。
# 所有 CHANGE_ME 占位符必须替换为部署环境的值，或通过私有配置文件/Secrets 注入。
# 变量使用 .NET 配置的层级写法（双下划线表示配置节分隔，如 Database__Host）。

# ── 基础 ────────────────────────────────────────────────────────────────
# 监听地址；生产环境建议由反向代理终止 TLS，仅监听回环或容器内网
Urls=http://0.0.0.0:5080
# 允许访问的主机名（分号分隔），必须与实际部署域名/IP 一致，禁止使用通配
AllowedHosts=localhost;127.0.0.1

# 发号服务实例编号；同一发号域内唯一，单实例默认 1
Id__WorkerId=1

# ── 数据库（PostgreSQL 17 + TimescaleDB 2.31）────────────────────────────
Database__Host=localhost
Database__Port=55432
Database__Database=oob_management
Database__Username=CHANGE_ME_DATABASE_USER
Database__Password=CHANGE_ME_DATABASE_PASSWORD
# 生产环境请改用私有连接配置文件注入，不要把真实密码写入源码或镜像

# ── 采集与电源控制 ──────────────────────────────────────────────────────
# 是否启用后台只读采集
Collector__Enabled=true
# 真实电源控制开关；默认关闭，仅在明确授权与人工确认后启用
PowerControl__Enabled=false

# ── 私有配置目录（服务器/桌面宿主读取 application.json、密钥等）──────────
# 绝对路径；目录权限应仅允许运行账号访问
Oob__PrivateDirectory=/path/to/private
# 密钥目录是否只读挂载
Oob__ReadOnlyKeys=true

# ── 初始管理员（仅首次初始化空库时使用，使用后请移除）──────────────────
Bootstrap__AdminPassword=CHANGE_ME_INITIAL_ADMIN_PASSWORD

# ── 邮件（SMTP）通知与运行报表 ─────────────────────────────────────────
Mail__Enabled=false
Mail__Host=smtp.example.com
Mail__Port=587
Mail__Username=CHANGE_ME_SMTP_USER
Mail__Password=CHANGE_ME_SMTP_PASSWORD
Mail__FromAddress=oob@example.com
Mail__Security=StartTls
# 允许解析到私网地址的 SMTP 主机精确白名单（分号分隔，默认空表示拒绝私网）
Mail__AllowedPrivateHosts=

# ── 虚拟介质 ────────────────────────────────────────────────────────────
VirtualMedia__StorageDirectory=/var/lib/oob/virtual-media
VirtualMedia__PublicBaseUrl=https://oob.example.com
VirtualMedia__MaximumImageBytes=17179869184
VirtualMedia__MaximumLibraryBytes=68719476736
VirtualMedia__MaximumImages=128

# ── MCP 服务（默认关闭；启用需 HTTPS 与证书）────────────────────────────
Mcp__PublicBaseUrl=https://oob.example.com
Mcp__SigningCertificatePath=/path/to/private/mcp-signing.pfx
Mcp__EncryptionCertificatePath=/path/to/private/mcp-encryption.pfx
Mcp__CertificatePassword=CHANGE_ME_CERTIFICATE_PASSWORD

# ── 日志 ────────────────────────────────────────────────────────────────
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning
