# 确认证书与部署目标后安装到 oob-management.service.d/20-https.conf。
# 使用 Kestrel 直接终止 TLS；私钥只存服务器受限目录，不写入环境变量正文。
[Service]
ExecStart=
ExecStart=/opt/dotnet/dotnet /opt/oob-management/current/OobManagement.Api.dll
Environment=ASPNETCORE_URLS=
Environment=Urls=
Environment=HttpsRedirection__Enabled=true
Environment=HttpsRedirection__HttpsPort=443
Environment=Kestrel__Endpoints__Http__Url=http://0.0.0.0:80
Environment=Kestrel__Endpoints__Http__Protocols=Http1
Environment=Kestrel__Endpoints__Https__Url=https://0.0.0.0:443
# 当前控制台网关采用 GET Upgrade；保持 HTTP/1.1，避免 HTTP/2 CONNECT 路由差异。
Environment=Kestrel__Endpoints__Https__Protocols=Http1
Environment=Kestrel__Endpoints__Https__Certificate__Path=/etc/oob-management/tls/server.crt
Environment=Kestrel__Endpoints__Https__Certificate__KeyPath=/etc/oob-management/tls/server.key
# 服务继续使用 oob 用户；只增加绑定 80/443 所需能力，不以 root 运行应用。
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
