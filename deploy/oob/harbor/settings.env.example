# 仅放非秘密选项。复制到仓库外的 deploy.env，再按目标填写。
OOB_PRIVATE_DIRECTORY=CHANGE_TO_ABSOLUTE_PRIVATE_DIRECTORY
OOB_ALLOWED_HOSTS=CHANGE_TO_DEPLOYMENT_HOST;localhost;127.0.0.1
OOB_REGISTRY=registry.example.com:443
OOB_IMAGE_TAG=1.0
# 留空不导出宿主目录，使用原命名卷；填写绝对路径时绑定该宿主目录。
OOB_POSTGRES_DATA_DIRECTORY=
OOB_HTTP_BIND=0.0.0.0
OOB_HTTP_PORT=8000
OOB_WORKER_ID=1
OOB_COLLECTOR_ENABLED=true
OOB_KEYS_READ_ONLY=true
