# 编辑器统一配置
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets,slnx}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{json,jsonc,yaml,yml,ts,tsx,js,jsx,cjs,mjs,css,less,html}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.{sql}]
indent_size = 4

[Makefile]
indent_style = tab
